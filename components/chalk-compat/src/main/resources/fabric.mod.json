{
  "schemaVersion": 1,
  "id": "chalk_polymer_compat",
  "version": "${version}",
  "name": "Chalk Polymer Compatibility",
  "description": "Internal Thenathe Mod Suite compatibility component; shared capability negotiation.",
  "authors": [
    "THENATHE"
  ],
  "license": "MIT",
  "environment": "*",
  "mixins": [
    "chalk_polymer_compat.mixins.json"
  ],
  "depends": {
    "minecraft": "${mc}",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "thenathe_mod_suite": "*"
  },
  "entrypoints": {
    "main": [
      "com.thenathe.chalkcompat.ChalkCompatInit"
    ],
    "client": [
      "com.thenathe.chalkcompat.ChalkCompatClient"
    ]
  },
  "suggests": {
    "chalk": "${chalk}",
    "polymer-core": "${polymer}",
    "polymer-resource-pack": "${polymer}",
    "polymer-virtual-entity": "${polymer}"
  }
}
