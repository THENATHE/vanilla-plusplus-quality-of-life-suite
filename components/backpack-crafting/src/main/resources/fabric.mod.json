{
  "schemaVersion": 1,
  "id": "vpp_backpack_crafting",
  "version": "${version}",
  "name": "Backpack Crafting",
  "description": "Tool Pouch toolbox upgrades add crafting and a recipe book to Tiered Backpacks without replacing its developer source.",
  "authors": ["THENATHE"],
  "license": "MIT",
  "environment": "*",
  "contact": {
    "sources": "https://github.com/THENATHE/vanilla-plusplus-quality-of-life-suite",
    "issues": "https://github.com/THENATHE/vanilla-plusplus-quality-of-life-suite/issues"
  },
  "entrypoints": {
    "main": ["com.thenathe.backpackcrafting.BackpackCrafting"],
    "client": ["com.thenathe.backpackcrafting.client.BackpackCraftingClient"]
  },
  "mixins": [
    "backpack_crafting.mixins.json",
    {
      "config": "backpack_crafting_client.mixins.json",
      "environment": "client"
    },
    {
      "config": "backpack_crafting_brbr.mixins.json",
      "environment": "client"
    },
    {
      "config": "backpack_crafting_sorted.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "26.3",
    "java": ">=25",
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0+26.3",
    "tiered_backpacks": "=1.0.20",
    "toolpouch": "=1.1.10",
    "sso_backpack_toolpouch_mapstitch_shim": "=1.4.1+26.3"
  },
  "suggests": {
    "brb": ">=1.11.1+26.3",
    "polymer-core": "0.18.2+26.3",
    "polymer-resource-pack": "0.18.2+26.3",
    "sorted": ["=0.1.25", "=0.1.26"]
  },
  "custom": {
    "modmenu": {
      "parent": "vpp_mod_suite"
    }
  }
}
